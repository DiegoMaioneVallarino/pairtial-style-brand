{
  "name": "pairtial-style-brand",
  "version": "0.4.3",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/brand"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "node --watch server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test server/*.test.mjs",
    "fonts": "node scripts/fonts.mjs"
  },
  "dependencies": {
    "@pairtial/style-brand": "0.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "@vitejs/plugin-react": "^4.3.4"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
